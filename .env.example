# Públicas: Next.js las incluye en el bundle del navegador en el build.
# La anon key es la clave pública del proyecto. RLS limita cada fila a su usuario.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor, para el paso que va a insertar gastos de Mercado Pago.
# No la expongas al navegador y no le pongas el prefijo NEXT_PUBLIC_.
# La app de hoy no la lee. La service role omite RLS.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
