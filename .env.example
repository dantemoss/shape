# Públicas: Next.js las incluye en el bundle del navegador en el build.
# La anon key es la clave pública del proyecto. RLS limita cada fila a su usuario.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor. No uses el prefijo NEXT_PUBLIC_: estas claves no tienen que llegar al navegador.
# SUPABASE_SERVICE_ROLE_KEY omite RLS. El atajo no la ve; la usa POST /api/gastos.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Contraseña que inventás para el atajo de iOS. Va en el encabezado Authorization: Bearer.
SHAPE_INGEST_TOKEN=generate-a-long-random-string

# UUID de tu usuario: Supabase → Authentication → Users.
SHAPE_OWNER_USER_ID=00000000-0000-4000-8000-000000000000
